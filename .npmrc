# better-sqlite3 is compiled here, never downloaded as a prebuild.
#
# @liferay/accelerator-sdk pins better-sqlite3 12.x, whose install script is
# `prebuild-install || node-gyp rebuild`. prebuild-install takes its target
# architecture from npm_config_arch and caches downloads under
# ~/.npm/_prebuilds, so one install that asked for the wrong arch leaves a
# darwin-x64 binary that later installs serve again from cache. That happened:
# an x86_64 better_sqlite3.node landed in the SDK's nested copy on an arm64
# machine, and dlopen on the wrong cputype aborts the process rather than
# throwing, so nothing could catch it. See #793.
#
# Naming the package rather than using `true` keeps every other native
# dependency on its prebuilds. The hoisted better-sqlite3 13.x is unaffected:
# it carries prebuildify binaries in its own tarball, one per architecture,
# with nothing to fetch and no arch to get wrong.
build-from-source=better-sqlite3
