# =============================================================================
# Liferay AI Commerce Accelerator - environment configuration
#
# Copy to .env and fill in. Everything here is read by the microservice at
# startup; see client-extensions/ai-commerce-accelerator-microservice/utils/
# constants.cjs for the authoritative list. The listener settings below are the
# exception: they are resolved by server.cjs through config-node, not declared
# in constants.cjs.
# =============================================================================

# -----------------------------------------------------------------------------
# Liferay connection
# -----------------------------------------------------------------------------

# Target Liferay instance, used by the microservice for Headless API calls.
# e.g. http://localhost:8080 or https://aica.demo
LIFERAY_API_URL=

# The same instance as seen from a browser. Usually identical to LIFERAY_API_URL;
# they differ when the microservice reaches Liferay over an internal container
# hostname while users reach it over a public one.
LIFERAY_URL=

# Liferay SaaS / LXC conventions. Exported automatically by
# scripts/run-e2e-ldm.sh, so leave these blank when using the LDM workflow.
# Set them by hand only when running the microservice against a native bundle -
# see docs/LOCAL_EXECUTION.md.
COM_LIFERAY_LXC_DXP_MAIN_DOMAIN=
COM_LIFERAY_LXC_DXP_SERVER_PROTOCOL=

# Liferay API credentials (Basic Authentication)
# Used by the microservice and setup scripts for administrative bootstrap
# operations, such as auto-provisioning catalogs/channels and verifying DXP
# settings. Typically a portal administrator account (e.g. test@liferay.com).
LIFERAY_API_USERNAME=
LIFERAY_API_PASSWORD=

# Liferay OAuth2 application credentials for the microservice (client credentials flow).
# Generated inside Liferay under Control Panel -> Client Extensions, for the
# Microservice Headless Server. Used at runtime to authenticate Headless calls.
# Leaving these blank no longer selects Basic on its own. Until
# accelerator-sdk v0.10.0 the SDK inferred it from LIFERAY_API_USERNAME and
# LIFERAY_API_PASSWORD being present; that inference is gone, so Basic has to
# be asked for with LIFERAY_AUTH_METHOD below. Blank OAuth variables and no
# declared method now fail at startup with "Liferay authentication is not
# configured". See #950.
LIFERAY_OAUTH_CLIENT_ID=
LIFERAY_OAUTH_CLIENT_SECRET=

# Where AICA reads its OWN configuration - the AI settings, prompts, chunk
# sizes and timeouts held in the AICAConfiguration object - when that is not the
# instance it writes commerce data to.
#
# Blank means "the same instance", which is every colocated deployment and the
# default. Set these for the supported "local microservice, remote target"
# topology: the client extensions are deployed to a local bundle, the data goes
# to a remote instance, and that remote instance has no c_aicaconfiguration
# object at all. Until #824 AICA read its settings from the target regardless,
# found nothing, and silently used built-in defaults - a requestTimeoutMs of
# 300000 set in the panel had no effect and the run died three times at 60s.
#
# A full connection, not an external reference code: resolving an ERC goes
# through Liferay's routes tree, which exists only where the extension is
# deployed - and this topology is exactly where it is not.
#
# A per-run value set in the configuration panel outranks these, because on a
# shared deployment ENV is one value for every user of the server.
AICA_CONFIG_SOURCE_URL=
AICA_CONFIG_SOURCE_CLIENT_ID=
AICA_CONFIG_SOURCE_CLIENT_SECRET=

# Application base of the search-reindex OSGi module, if this deployment
# does not serve it at the default /o/search-reindex. The OAuth scope
# client-extension.yaml grants for it (Custom.Search.Reindex.everything.write)
# has to keep naming the same deployment. See #674.
LIFERAY_REINDEX_BASE_PATH=

# -----------------------------------------------------------------------------
# AI providers
#
# Implemented: openai, gemini, anthropic, nanobanana
# (services/ai-providers/providerFactory.cjs).
#
# Claude generates data only - it cannot produce images. When images are
# required, configure a dedicated media provider (OpenAI or NanoBanana)
# rather than leaving the media provider set to inherit.
#
# Only the provider you actually select needs a key.
# -----------------------------------------------------------------------------

# OpenAI - data generation and images (DALL-E).
# Key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini - data generation and images.
# Key from: https://aistudio.google.com/apikey
#
# Set to the literal value mock-sandbox to generate deterministic mock data at
# no cost, with no API calls. Useful for developing E2E workflows.
#   GEMINI_API_KEY=mock-sandbox
GEMINI_API_KEY=

# Anthropic Claude - data generation only; Claude cannot generate images, so a
# separate media provider must be configured when images are required.
# Key from: https://console.anthropic.com -> API Keys
# Note that a Claude.ai subscription is billed separately from API usage.
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Liferay routes (OAuth credential discovery)
# -----------------------------------------------------------------------------

# Where Liferay writes each client extension's configuration when it is
# deployed, including the OAuth client id and secret. config-node reads these
# as config trees - see config.node.config.trees in application.json - and the
# microservice then needs no credentials of its own.
#
# Normally you do not set these. The Liferay Workspace plugin sets them on its
# packageRun* tasks, so starting the microservice with
#   ./gradlew :client-extensions:ai-commerce-accelerator-microservice:packageRunStart
# discovers everything on its own. These entries are the fallback for starting
# it outside Gradle.
#
# Point them at the tree Liferay wrote into the bundle:
#
#   LIFERAY_ROUTES_CLIENT_EXTENSION=/abs/path/to/bundles/routes/default/ai-commerce-accelerator-microservice
#   LIFERAY_ROUTES_DXP=/abs/path/to/bundles/routes/default/dxp
#
# Leave them unset only if you intend to supply credentials another way. With
# no routes tree and no LIFERAY_OAUTH_CLIENT_ID, startup fails authentication.
LIFERAY_ROUTES_CLIENT_EXTENSION=
LIFERAY_ROUTES_DXP=

# REQUIRED if this deployment authenticates with LIFERAY_API_USERNAME and
# LIFERAY_API_PASSWORD rather than OAuth - which is the usual local setup when
# the routes tree is unavailable and LIFERAY_OAUTH_CLIENT_ID is empty.
#
# Until accelerator-sdk v0.10.0 the SDK inferred Basic whenever a config
# carried no clientId and these two variables happened to be present. Nobody
# asked for it and nothing said so, and the variables are process-wide, so a
# shell profile could change the auth mechanism of every caller in the process.
# That inference is gone: Basic must now be asked for, here or as
# `authMethod: 'basic'` on an individual config.
#
# Without it, a deployment with no OAuth credentials fails at the startup
# connectivity probe with "Liferay authentication is not configured" rather
# than connecting as whoever these variables name.
# LIFERAY_AUTH_METHOD=basic

# Optional, and best left unset. A generic fallback used only when the
# provider-specific key above is empty.
#
# It carries no indication of which service it belongs to, so if it does not
# match the selected provider it would be transmitted to the wrong one - an
# OpenAI key sent to api.anthropic.com is disclosed to Anthropic and comes back
# as an ordinary authentication error. Generation is now refused when the key
# plainly belongs to a different provider, but the safe arrangement is to set
# the provider-specific variables above and leave this empty.
#
# Keys that match no known provider - a gateway, Azure OpenAI, a self-hosted
# endpoint - are allowed through, since they cannot be checked either way.
# AI_API_KEY=

# Optional: dedicated key for AI media (images and PDFs). Set this when media is
# generated by a different provider, or a different account, from the data.
# Subject to the same provider check as the key above; Nano Banana is a Google
# endpoint and uses GEMINI_API_KEY.
# AI_MEDIA_API_KEY=

# AI_MODEL was documented here and read by nothing, from the commit that
# introduced it until it was removed in #1065. Model selection lives in the
# `ai-config` object, editable in the AI Configuration panel, with a per-run
# override on `aica generate --ai-model`. There is no environment variable for
# it, which is why there is no line to uncomment here.

# Optional: the pre-flight prompt guardrail, in estimated tokens. A prompt
# estimated above this is refused before it is sent, and the refusal names this
# number - so a value set by mistake produces a confident rejection of a prompt
# that was fine under the limit you meant. Raise it for large catalogues; a
# smaller chunk size is usually the better answer.
# Defaults to 15000. A value that is not a number is reported at startup and
# the default is used.
# AICA_MAX_TOKEN_LIMIT=15000

# Optional: bypass the guardrail above rather than raising it. This is the
# escape hatch the refusal message points at. Defaults to false.
# ALLOW_LARGE_PROMPTS=false

# -----------------------------------------------------------------------------
# Microservice listener
# -----------------------------------------------------------------------------

# The address the microservice binds. Both are read by server.cjs through
# config-node's `lookupConfig`, which uppercases the key and turns dots into
# underscores - so `server.port` is this SERVER_PORT and `server.host` is this
# SERVER_HOST. They are deliberately not declared in constants.cjs; a second
# declaration there was never read by anything, from the commit that added it
# (67c6cdf) until it was removed, while looking configurable the whole time (#1058).
#
# Precedence for the port: PORT, then SERVER_PORT, then `server.port` in the
# microservice's application.json (3001), then server.cjs's own 3001 fallback.
# PORT is what Liferay Cloud sets, which is why it wins.
# SERVER_PORT=3001

# Bind address. Defaults to 0.0.0.0, which accepts connections on every
# interface - required inside a container. Set 127.0.0.1 to accept only local
# connections when running the microservice directly on a workstation.
# SERVER_HOST=0.0.0.0

# -----------------------------------------------------------------------------
# CLI environment discovery
# -----------------------------------------------------------------------------

# The `aica` CLI reads a `.env` at startup: the working directory and its
# parent, then the two directories above `scripts/aica-cli.cjs`. Those last two
# are why the repository's `.env` is found wherever you run `aica` from - and
# why changing directory cannot get you an environment without it. The loader
# only fills variables that are unset, so passing an empty value does not clear
# one either.
#
# AICA_IGNORE_DOTENV=1 skips that discovery and uses only the environment as
# given. Set it for a scripted run that must fail rather than quietly inherit a
# developer's target, or for a test asserting the unconfigured path.
#
# It has to be set in the environment. Putting it in this file cannot work: the
# check happens before the file is read.
# AICA_IGNORE_DOTENV=1

# -----------------------------------------------------------------------------
# Administrative authorization gate
# -----------------------------------------------------------------------------

# Required for /delete/*, /config/save and /mcp/*.
# Comma-separated allowlist of numeric Liferay user IDs permitted to perform
# administrative or destructive actions.
#
# User IDs only. Liferay issues no email claim on any OAuth2 grant - measured
# against DXP 2026.q3.0 - so an address here can never match and the route will
# refuse every caller. This file previously showed an address, which is why the
# service logs a specific error when it finds one (#930).
#
# The id is the `sub` claim of the caller's token, and the same value as the
# user's ID in Control Panel -> Users.
# Example: AICA_ADMINS=20132,20456
#
# A client-credentials caller is refused whatever this contains: such an
# application is bound to a portal user and presents that user's id, so it
# cannot be distinguished by identity alone.
# AICA_ADMIN_EMAILS is accepted as an alias.
# If unset, all destructive actions are denied - it fails closed.
AICA_ADMINS=

# Comma-separated allowlist of OAuth2 *application* client IDs permitted to
# perform the same actions without a person - an E2E teardown, for instance.
#
# Separate from AICA_ADMINS on purpose. A client-credentials application is
# bound to a portal user and presents that user's id, so it cannot be told from
# that user by identity alone; naming the application is what makes granting a
# machine a deliberate act rather than a side effect of the binding. An
# application named here is admitted whatever AICA_ADMINS contains, and one that
# is not is refused whatever AICA_ADMINS contains (#988).
#
# Use a dedicated application, not the microservice's own headless-server
# credential - otherwise anything that can read this file gains the right to
# delete all commerce data.
#
# Every admission through this list is logged at warn with the client id, which
# is the audit trail for a destructive action taken by no person.
# Example: AICA_ADMIN_CLIENTS=id-a1b2c3d4-...
# If unset, no machine caller is admitted - it fails closed.
AICA_ADMIN_CLIENTS=

# The application the CLI authenticates as when nobody is present to sign in -
# an E2E teardown, for instance. Exchanged for a token at /o/oauth2/token and
# sent as a bearer credential.
#
# Deliberately not the LIFERAY_API_* pair: those authenticate the microservice
# to Liferay, and reusing them would mean anything able to read this file could
# delete every commerce object. Use a dedicated application, and name its client
# id in AICA_ADMIN_CLIENTS above - the credentials alone grant nothing (#988).
#
# Interactive operators should not set these. They supply their own identity
# with --token or AICA_ADMIN_TOKEN instead.
AICA_ADMIN_CLIENT_ID=
AICA_ADMIN_CLIENT_SECRET=

# The user-agent application an operator signs in through from a terminal.
#
# With this set, a gated command with no token and no application credentials
# opens the system browser, the operator signs in as themselves, and the CLI
# receives an authorization code on a loopback listener - RFC 8252, the flow gh
# and gcloud use. No client secret: a secret shipped inside a distributed CLI is
# not one, and PKCE is what replaces it (#989).
#
# Offered only on a terminal. An unattended run uses AICA_ADMIN_CLIENT_* above,
# which takes precedence, because a browser nobody is watching would simply
# hang.
#
# The token is never written to disk.
AICA_CLI_CLIENT_ID=

# -----------------------------------------------------------------------------
# Dataset packages and the media archive
# -----------------------------------------------------------------------------

# A dataset package (.aicap) carries a dataset and its pictures, so the same
# catalogue can be promoted between instances rather than regenerated. Two
# routes produce one, and both stage the binaries through the media archive:
#
#   GET  /api/v1/export-commerce-bundle?sessionId=...  reads this service's own
#        session and the media on disk. No instance, no credentials.
#   POST /api/v1/extract-commerce-bundle              reads a live Liferay,
#        which needs access and a round trip per attachment. Against a session,
#        it fills in that session's archive, so a later export is cheap.
#
# There is no switch that stops the writing: staging is how a package is built,
# so skipping it would produce a package with no pictures and no error.

# Where media goes. Defaults beside the workflow database in the home
# directory, and for the same reason it is there - inside the repository, state
# gets destroyed by ordinary tooling, which has happened twice.
# MEDIA_ARCHIVE_PATH=~/.aica/media

# The three settings below are also editable in the Media Archive configuration
# panel, which is where an operator should change them: the panel writes to
# Liferay, and the microservice resolves configuration -> environment ->
# default. A variable set here wins wherever nothing is configured, which is
# what a deployment wants. The path is not in the panel, deliberately: it names
# a directory on the machine running this service.

# Whether a directory staged purely to build a package survives the package.
# On by default. Off means an extract against a live instance cleans up after
# itself as soon as its package has been sent. A run's own media is not staging
# and is governed by the retention below either way.
#
# MEDIA_ARCHIVE_ENABLED is honoured as an alias: it used to decide whether
# media was written at all, and a deployment that set it to false asked for the
# least media this service can keep.
# MEDIA_ARCHIVE_RETAIN=true

# Retention. Age first - a run stays packageable for a while and then does not
# - with a session-count cap behind it, because one busy day can fill a volume
# well inside the retention window. Media whose session has been deleted is
# swept regardless, at startup and after the routes that clear sessions.
# MEDIA_ARCHIVE_RETENTION_HOURS=72
# MEDIA_ARCHIVE_MAX_SESSIONS=10

# The import's own request ceiling. A package is a whole catalogue and its
# media, so it is sized separately from every other route (REQUEST_MAX_BYTES).
# IMPORT_MAX_BYTES=268435456
