# =============================================================================
# Liferay AI Commerce Accelerator - environment configuration
#
# Copy to .env and fill in. Everything here is read by the microservice at
# startup; see client-extensions/ai-commerce-accelerator-microservice/utils/
# constants.cjs for the authoritative list.
# =============================================================================

# -----------------------------------------------------------------------------
# Liferay connection
# -----------------------------------------------------------------------------

# Target Liferay instance, used by the microservice for Headless API calls.
# e.g. http://localhost:8080 or https://aica.demo
LIFERAY_API_URL=

# The same instance as seen from a browser. Usually identical to LIFERAY_API_URL;
# they differ when the microservice reaches Liferay over an internal container
# hostname while users reach it over a public one.
LIFERAY_URL=

# Liferay SaaS / LXC conventions. Exported automatically by
# scripts/run-e2e-ldm.sh, so leave these blank when using the LDM workflow.
# Set them by hand only when running the microservice against a native bundle -
# see docs/LOCAL_EXECUTION.md.
COM_LIFERAY_LXC_DXP_MAIN_DOMAIN=
COM_LIFERAY_LXC_DXP_SERVER_PROTOCOL=

# Liferay API credentials (Basic Authentication)
# Used by the microservice and setup scripts for administrative bootstrap
# operations, such as auto-provisioning catalogs/channels and verifying DXP
# settings. Typically a portal administrator account (e.g. test@liferay.com).
LIFERAY_API_USERNAME=
LIFERAY_API_PASSWORD=

# Liferay OAuth2 application credentials for the microservice (client credentials flow).
# Generated inside Liferay under Control Panel -> Client Extensions, for the
# Microservice Headless Server. Used at runtime to authenticate Headless calls.
# Leaving these blank during local development forces the microservice to fall
# back to the administrator Basic Auth credentials above.
LIFERAY_OAUTH_CLIENT_ID=
LIFERAY_OAUTH_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# AI providers
#
# Implemented: openai, gemini, anthropic, nanobanana
# (services/ai-providers/providerFactory.cjs).
#
# Claude generates data only - it cannot produce images. When images are
# required, configure a dedicated media provider (OpenAI or NanoBanana)
# rather than leaving the media provider set to inherit.
#
# Only the provider you actually select needs a key.
# -----------------------------------------------------------------------------

# OpenAI - data generation and images (DALL-E).
# Key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini - data generation and images.
# Key from: https://aistudio.google.com/apikey
#
# Set to the literal value mock-sandbox to generate deterministic mock data at
# no cost, with no API calls. Useful for developing E2E workflows.
#   GEMINI_API_KEY=mock-sandbox
GEMINI_API_KEY=

# Anthropic Claude - data generation only; Claude cannot generate images, so a
# separate media provider must be configured when images are required.
# Key from: https://console.anthropic.com -> API Keys
# Note that a Claude.ai subscription is billed separately from API usage.
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Liferay routes (OAuth credential discovery)
# -----------------------------------------------------------------------------

# Where Liferay writes each client extension's configuration when it is
# deployed, including the OAuth client id and secret. config-node reads these
# as config trees - see config.node.config.trees in application.json - and the
# microservice then needs no credentials of its own.
#
# In LXC these are injected. Running locally they must be set by hand, pointing
# at the tree Liferay wrote into the bundle:
#
#   LIFERAY_ROUTES_CLIENT_EXTENSION=/abs/path/to/bundles/routes/default/ai-commerce-accelerator-microservice
#   LIFERAY_ROUTES_DXP=/abs/path/to/bundles/routes/default/dxp
#
# Leave them unset only if you intend to supply credentials another way. With
# no routes tree and no LIFERAY_OAUTH_CLIENT_ID, startup fails authentication.
LIFERAY_ROUTES_CLIENT_EXTENSION=
LIFERAY_ROUTES_DXP=

# Forces basic authentication regardless of what OAuth discovery finds, using
# LIFERAY_API_USERNAME and LIFERAY_API_PASSWORD. Useful locally when the routes
# tree is unavailable.
# LIFERAY_AUTH_METHOD=basic

# Optional, and best left unset. A generic fallback used only when the
# provider-specific key above is empty.
#
# It carries no indication of which service it belongs to, so if it does not
# match the selected provider it would be transmitted to the wrong one - an
# OpenAI key sent to api.anthropic.com is disclosed to Anthropic and comes back
# as an ordinary authentication error. Generation is now refused when the key
# plainly belongs to a different provider, but the safe arrangement is to set
# the provider-specific variables above and leave this empty.
#
# Keys that match no known provider - a gateway, Azure OpenAI, a self-hosted
# endpoint - are allowed through, since they cannot be checked either way.
# AI_API_KEY=

# Optional: dedicated key for AI media (images and PDFs). Set this when media is
# generated by a different provider, or a different account, from the data.
# Subject to the same provider check as the key above; Nano Banana is a Google
# endpoint and uses GEMINI_API_KEY.
# AI_MEDIA_API_KEY=

# Optional: override the default model for the selected provider.
# AI_MODEL=

# -----------------------------------------------------------------------------
# Administrative authorization gate
# -----------------------------------------------------------------------------

# Required for /delete/*, /config/save and /mcp/*.
# Comma-separated allowlist of Liferay account emails or numeric user IDs (sub)
# permitted to perform administrative or destructive actions.
# Example: AICA_ADMINS=test@liferay.com,20132
# AICA_ADMIN_EMAILS is accepted as an alias.
# If unset, all destructive actions are denied - it fails closed.
AICA_ADMINS=
