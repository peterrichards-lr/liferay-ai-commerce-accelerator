{
  "private": true,
  "bin": {
    "aica": "./scripts/aica-cli.cjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": {
    "packages": [
      "client-extensions/ai-commerce-accelerator-microservice",
      "client-extensions/ai-commerce-accelerator-configuration",
      "client-extensions/ai-commerce-accelerator-frontend"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.0.2",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "baseline-browser-mapping": "^2.11.25",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "markdownlint-cli": "^0.49.1",
    "prettier": "^3.9.8",
    "yaml": "^2.9.1"
  },
  "resolutions": {
    "markdown-it": "^14.2.0",
    "js-yaml": "^4.2.0",
    "uuid": "^11.1.1",
    "undici": "^7.28.0",
    "dompurify": "^3.4.11",
    "@liferay/accelerator-sdk": "git+https://github.com/peterrichards-lr/liferay-accelerator-sdk.git#v0.12.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "^1.2.9",
    "@rolldown/binding-darwin-x64": "^1.2.9",
    "@rollup/rollup-darwin-arm64": "4.63.4",
    "@rollup/rollup-darwin-x64": "4.63.4",
    "@rollup/rollup-linux-x64-gnu": "4.63.4"
  },
  "scripts": {
    "prepare": "husky || true",
    "test": "FORCE_COLOR=0 yarn workspaces run test && yarn test:scripts",
    "test:scripts": "python3 -m unittest discover -s scripts -p 'test_*.py'",
    "smoke": "playwright test --config playwright/playwright.config.js",
    "verify": "node scripts/test-e2e-orchestrator.js",
    "verification": "playwright test --config playwright/playwright-e2e.config.js",
    "preflight": "node scripts/preflight.mjs",
    "ldm:init": "yarn preflight && bash scripts/run-e2e-ldm.sh --init-only -k",
    "ldm:init-from": "ldm init-from . aica --db postgresql --no-captcha --fast-login --feature LPD-35443 --sidecar --host-name aica-e2e.demo --build",
    "ldm:monitor": "ldm monitor . -p aica",
    "lint": "yarn workspaces run lint && yarn lint:md && yarn lint:docs && yarn lint:cx && yarn lint:json && yarn lint:lockfile",
    "verify:all": "npm run lint && npm test && bash scripts/run-e2e-ldm.sh -v -k",
    "verify:live": "node scripts/verify-live-ai.mjs",
    "lint:json": "node scripts/check-duplicate-json-keys.cjs",
    "lint:lockfile": "node scripts/check-lockfile-drift.cjs",
    "lint:md": "markdownlint '**/*.md' --ignore '**/node_modules/**' --ignore '**/build/**' --ignore '**/bundles/**' --ignore '**/aica/**'",
    "lint:docs": "node scripts/check-docs-links.cjs",
    "lint:cx": "node scripts/validate-cx.js",
    "update-browser-data": "yarn add -D baseline-browser-mapping@latest -W && npx update-browserslist-db@latest -y"
  },
  "lint-staged": {
    "client-extensions/ai-commerce-accelerator-microservice/**/*.{js,cjs}": [
      "eslint --fix --config client-extensions/ai-commerce-accelerator-microservice/eslint.config.mjs",
      "prettier --write"
    ],
    "client-extensions/ai-commerce-accelerator-microservice/**/*.json": [
      "prettier --write"
    ],
    "client-extensions/ai-commerce-accelerator-microservice/**/*.md": [
      "prettier --write",
      "markdownlint"
    ],
    "client-extensions/ai-commerce-accelerator-configuration/**/*.{js,jsx}": [
      "eslint --fix --config client-extensions/ai-commerce-accelerator-configuration/eslint.config.js",
      "prettier --write"
    ],
    "client-extensions/ai-commerce-accelerator-configuration/**/*.json": [
      "prettier --write"
    ],
    "client-extensions/ai-commerce-accelerator-configuration/**/*.md": [
      "prettier --write",
      "markdownlint"
    ],
    "client-extensions/ai-commerce-accelerator-frontend/**/*.{js,jsx}": [
      "eslint --fix --config client-extensions/ai-commerce-accelerator-frontend/eslint.config.js",
      "prettier --write"
    ],
    "client-extensions/ai-commerce-accelerator-frontend/**/*.json": [
      "prettier --write"
    ],
    "client-extensions/ai-commerce-accelerator-frontend/**/*.md": [
      "prettier --write",
      "markdownlint"
    ],
    "scripts/**/*.{js,cjs,mjs}": [
      "prettier --write"
    ],
    "**/*.{js,cjs,mjs,json,yaml,yml}": [
      "prettier --write"
    ],
    "**/*.md": [
      "prettier --write",
      "markdownlint"
    ]
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "@liferay/accelerator-sdk": "git+https://github.com/peterrichards-lr/liferay-accelerator-sdk.git#v0.12.0",
    "@vitejs/plugin-react": "6.1.1",
    "ajv-formats": "3.0.1",
    "better-sqlite3": "13.0.3",
    "codemirror": "5.65.16",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "immutable": "5.1.9",
    "jsdom": "^30.1.1",
    "openai": "7.21.0",
    "react-codemirror2": "9.0.1",
    "rollup": "4.63.4",
    "vite": "8.3.0"
  },
  "version": "0.0.1"
}
